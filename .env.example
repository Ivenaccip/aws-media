# Copy to .env (repo root) and fill in what you use. Never commit .env.
# The cut → clean → TSX → SFX core needs AssemblyAI + ElevenLabs; Gemini is only for thumbnails.
# yt_upload / yt_stats use OAuth, not a key here (see tools/yt_upload_SETUP.md and CLAUDE.md).

# AssemblyAI — transcription for the cut pipeline (tools/transcribe.py). Required for /clean-cut.
# https://assemblyai.com
ASSEMBLYAI_API_KEY=

# ElevenLabs — voice isolation (tools/clean_voice.py --method eleven), SFX generation
# (tools/gen_sfx.py), and music beds (tools/gen_music.py). Needed for /clean-audio + /suggest-sfx.
# /clean-audio's local RNNoise method needs no key if you would rather skip this one.
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# Google Gemini — thumbnail generation with Nano Banana Pro (tools/gen_thumbnail.py, /packaging).
# Only needed if you render thumbnails.
# https://ai.google.dev
GEMINI_API_KEY=

# fal.ai — "videos con IA" route of /broll-ai (nanobanana image + veo3.1 lite image-to-video).
# Create the key at https://fal.ai/dashboard/keys (scope: API). Pay-per-use.
FAL_KEY=

# Blotato — two ways in:
#  · Skills de Claude Code (/broll-ai, /publicar): MCP server (https://mcp.blotato.com/mcp), no key here.
#  · Botón b3 del editor web (fn2, agendar por API): SÍ necesita la key del dashboard de Blotato.
BLOTATO_API_KEY=

# ============================================================================
# Rama generador (pipeline/ + server/, ex video-pipeline) — crear películas
# animadas desde texto. FAL_KEY (arriba) se comparte con /broll-ai.
# ============================================================================

# --- LLM de la rama generador (guionista, casting, director, research, QC) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# --- Langfuse (trazas + coste por película; sin claves el pipeline corre igual) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com   # EU: https://cloud.langfuse.com
# M10: 1 = leer los prompts desde Langfuse (label production) con fallback a
# prompts/*.md; sin el flag (default) siempre se usan los .md del repo.
#LANGFUSE_PROMPTS=1

# --- Google Drive como tu usuario (entrega de la película; las service accounts
#     no tienen cuota en "Mi unidad"). JSON de cliente OAuth "Aplicación de
#     escritorio"; luego: python auth_google.py (una vez) ---
GOOGLE_OAUTH_CLIENT_FILE=./oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=./token_drive.json
DRIVE_FOLDER_ID=

# --- Google service account (SOLO flujo v9 legado con hoja "Biblioteca IA") ---
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
SHEET_ID=
SHEET_RANGE=Hoja 1

# --- Rutas de media (F4.3) ---
# MEDIA_ROOT = raíz bajo la que viven videos/ (proyectos del editor) y work/
# (proyectos del generador). Sin setear = raíz del repo (dev local de siempre).
# En el servicio apuntará al volumen/S3. WORK_DIR (opcional) sobreescribe SOLO
# la carpeta del generador; si no está, es MEDIA_ROOT/work.
#MEDIA_ROOT=
#WORK_DIR=./work

# --- Runtime del generador ---
FFMPEG_BIN=ffmpeg
FAL_CONCURRENCY=4
GROK_TIMEOUT_S=300
VEO_TIMEOUT_S=720
VEO_MAX_ATTEMPTS=2

# --- QC de visión sobre la imagen de Grok (antes de Veo) ---
QC_ENABLED=1
QC_MODEL=gpt-5   # gpt-5-mini confunde izquierda/derecha
QC_MAX_RETRIES=1

# --- M4: recarga con Stripe (las crea y coloca el DUEÑO; nunca van por chat) ---
# whsec_… del webhook (dashboard → Developers → Webhooks → el endpoint del API)
#STRIPE_WEBHOOK_SECRET=
# URLs de los 3 Payment Links (uno por pack de tools/tarifas.json)
#STRIPE_LINK_100=
#STRIPE_LINK_500=
#STRIPE_LINK_1200=
