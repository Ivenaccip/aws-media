# Config por máquina — NUNCA se comitea (permite clonar en N máquinas sin pisarse)
.video-stack/
.claude/launch.json

# Proyectos del usuario (metraje, renders, estado de trabajo)
videos/*
!videos/.gitkeep
!videos/README.md

# Secretos
.env
# Paso 0 del entorno dev: el cableado de AWS que genera tools/env_local.py.
# OJO: el patrón `.env` de arriba NO cubre `.env.local` (gitignore no hace
# prefijos), así que van explícitos o se comitean solos.
.env.local
.env.*.local
# Listas de invitación y su bitácora: llevan correos personales reales.
tools/tanda*.txt
*.altas.tsv
service_account.json
oauth_client.json
token_drive.json

# Rama generador (pipeline/): producciones y venv legado
work/
.venv/

# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
remotion/out/

# Repos upstream vendorizados (solo referencia de verificación; se clonan con
# `git clone` — ver docs/DRIFT.md)
vendor/

# Scratch
*.log

remotion-longform/out/
# generados por `npm run gen` (remotion-longform) — derivados de src/shots/
remotion-longform/src/registry.gen.tsx
remotion-longform/src/shots.manifest.json
media/library/faces/*
!media/library/faces/README.md
media/projects/
.youtube/

# Chrome Headless Shell que descarga Remotion
.remotion/

# CDK synth output
infra/cdk.out/

# UI·6: lo compila `npm run build` (y la etapa web del Dockerfile)
web/dist/
