# Config por máquina — NUNCA se comitea (permite clonar en N máquinas sin pisarse)
.video-stack/
.claude/launch.json

# Proyectos del usuario (metraje, renders, estado de trabajo)
videos/*
!videos/.gitkeep
!videos/README.md

# Secretos
.env
service_account.json
oauth_client.json
token_drive.json

# Rama generador (pipeline/): producciones y venv legado
work/
.venv/

# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
remotion/out/

# Repos upstream vendorizados (solo referencia de verificación; se clonan con
# `git clone` — ver docs/DRIFT.md)
vendor/

# Scratch
*.log

remotion-longform/out/
# generados por `npm run gen` (remotion-longform) — derivados de src/shots/
remotion-longform/src/registry.gen.tsx
remotion-longform/src/shots.manifest.json
media/library/faces/*
!media/library/faces/README.md
media/projects/
.youtube/

# Chrome Headless Shell que descarga Remotion
.remotion/

# CDK synth output
infra/cdk.out/

# Volcados de Cygwin cuando un .exe revienta en Git Bash (mordió el 22-sep-2026)
*.stackdump
